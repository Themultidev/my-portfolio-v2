{
  "name": "mytail",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint src/app src/components/portfolio src/components/overview src/components/auth src/components/PortfolioEffects.tsx src/lib src/proxy.ts tests prisma/*.ts prisma.config.ts next.config.ts playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "check:parity": "node scripts/check-static-parity.mjs",
    "port:html": "node scripts/port-html-components.mjs",
    "check:visual": "playwright test",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "test:db": "node --conditions=react-server --import tsx --test tests/database/database.test.ts",
    "db:seed": "tsx prisma/seed.ts",
    "test:seed": "node --import tsx --test tests/database/seed.test.ts tests/database/seed-artifacts.test.ts",
    "auth:setup": "node scripts/setup-auth-env.mjs",
    "test:auth": "node --conditions=react-server --import tsx --test tests/auth/unit.test.ts tests/auth/http.test.ts"
  },
  "devDependencies": {
    "@fontsource-variable/google-sans-code": "^5.3.1",
    "@fontsource/michroma": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/aos": "^3.0.8",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "parse5": "^8.0.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.9",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@next/env": "^16.3.8",
    "@prisma/client": "6.19.3",
    "@tailwindcss/vite": "^4.1.11",
    "aos": "^2.3.4",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  }
}
