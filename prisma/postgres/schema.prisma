// Models are shared with SQLite; regenerate with node scripts/sync-postgres-schema.mjs.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model ContentBlock {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  label     String
  updatedAt DateTime @updatedAt
}

model Stack {
  id       Int            @id @default(autoincrement())
  name     String         @unique
  svgPath  String
  order    Int            @default(0)
  projects ProjectStack[]
}

model Project {
  id          Int            @id @default(autoincrement())
  title       String
  photoUrl    String?
  description String?
  link        String?
  repoUrl     String?
  countryCode String?
  regionCode  String?
  order       Int            @default(0)
  published   Boolean        @default(true)
  stacks      ProjectStack[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ProjectStack {
  projectId Int
  stackId   Int
  order     Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stack     Stack   @relation(fields: [stackId], references: [id], onDelete: Restrict)

  @@id([projectId, stackId])
  @@index([stackId])
}

model PortfolioRevision {
  id        Int      @id @default(autoincrement())
  label     String
  before    String
  after     String
  undone    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PortfolioHistoryState {
  id      Int @id
  version Int @default(0)
}

model BlogPost {
  id          Int @id @default(autoincrement())
  slug        String @unique
  title       String
  excerpt     String @default("")
  body        String
  coverUrl    String?
  category    String
  featured    Boolean @default(false)
  published   Boolean @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  comments    BlogComment[]
  likes       BlogLike[]
  @@index([published, publishedAt])
}

model BlogComment {
  id          Int @id @default(autoincrement())
  postId      Int
  author      String
  body        String
  visitorHash String
  createdAt   DateTime @default(now())
  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@index([postId, createdAt])
}

model BlogLike {
  id          Int @id @default(autoincrement())
  postId      Int
  visitorHash String
  createdAt   DateTime @default(now())
  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([postId, visitorHash])
}

model BlogActionLimit {
  key         String @id
  count       Int @default(0)
  windowStart DateTime
}
