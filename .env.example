# EmailJS public browser identifiers. Existing VITE_EMAILJS_* names also work.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# SQLite paths are relative to prisma/schema.prisma (prisma/dev.db).
# Prisma CLI and Next.js both read .env.local and .env.
DATABASE_URL="file:./dev.db"

# On Vercel, use Neon's pooled PostgreSQL URL instead of the local file URL.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Connect a PUBLIC Vercel Blob store. Keep its token private.
# BLOB_READ_WRITE_TOKEN=

# Required by db:seed. Set privately in .env or .env.local; no default password.
ADMIN_EMAIL=
# At least 12 characters; at most 72 UTF-8 bytes. Spaces are preserved.
ADMIN_PASSWORD=

# Run npm run auth:setup to generate this privately in .env (or .env.local).
# At least 32 UTF-8 bytes. Never use a NEXT_PUBLIC_ prefix for this secret.
SESSION_SECRET=
# Exact origin without trailing slash. Use your HTTPS origin in production.
APP_ORIGIN="http://localhost:3000"

# Optional, server-only: improves GitHub activity API limits. Never use NEXT_PUBLIC_.
# GITHUB_TOKEN=
