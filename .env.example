# EmailJS public browser identifiers. Existing VITE_EMAILJS_* names also work.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# SQLite paths are relative to prisma/schema.prisma (prisma/dev.db).
# Prisma CLI and Next.js both read .env.local and .env.
DATABASE_URL="file:./dev.db"

# Required by db:seed. Set privately in .env.local; no default admin password.
ADMIN_EMAIL=
# At least 12 characters; at most 72 UTF-8 bytes. Spaces are preserved.
ADMIN_PASSWORD=
